# =====================================================================
# Telegram Userbot Multi-User SaaS Tizimi Sozlamalari (.env)
# =====================================================================

# 1. Telegram Bot Token (BotFather dan olingan token)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Administrator Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=8983737418

# 3. Birlamchi (Primary) Telegram API hisob ma'lumotlari
PRIMARY_API_ID=20319723
PRIMARY_API_HASH=01a4cedda56c677958b7d56d19e627fd

# 4. Zaxira (Fallback) Telegram API hisob ma'lumotlari
FALLBACK_API_ID=32709830
FALLBACK_API_HASH=41f3c9cc39bf0274ec7b28039a890d13

# 5. Ma'lumotlar bazasi (PostgreSQL yoki SQLite)
# Production (PostgreSQL): postgresql+asyncpg://userbot_user:strong_password@localhost:5432/userbot_db
# Mahalliy test uchun (SQLite): sqlite+aiosqlite:///saas_userbot.db
DATABASE_URL=sqlite+aiosqlite:///saas_userbot.db

# 6. Telefon raqamlarni shifrlash kaliti (Fernet 32-byte base64)
# Kalit yaratish: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 7. Birlamchi operatsion standartlar
DEFAULT_INTERVAL_MINUTES=60
DEFAULT_START_TIME=09:00
DEFAULT_END_TIME=21:00
DEFAULT_TIMEZONE=Asia/Tashkent

# 8. Xavfsiz oraliq kechikishlar (soniyalarda)
MIN_DELAY_BETWEEN_GROUPS=3
MAX_DELAY_BETWEEN_GROUPS=5
ROUND_JITTER_SECONDS=30
